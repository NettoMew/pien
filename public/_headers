# Cache rules for static hosts that read _headers (Cloudflare Pages, Netlify).
# Everything under /vm/ and /assets/ is named by its content hash: cache it forever.
# index.html stays fresh by default, and it is what points at the current names.

/vm/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
