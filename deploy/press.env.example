# press's settings (press/src/config.ts says what each one is). The two
# secrets are files, readable by press's user alone; nothing secret goes in
# here. The paths are as the container sees them (docs/deploy.md, with
# Docker); on a host of its own, they are the ones at the end.

PRESS_SITE=https://example.com
PRESS_OWNER=your-name
PRESS_LISTEN=0.0.0.0:8096
PRESS_DATA=/data
PRESS_SESSION_KEY_FILE=/run/secrets/session.key

# Logging in with GitHub as well, if wanted: an OAuth app whose callback is
# https://example.com/api/auth/github/callback. Empty: passkeys alone.
PRESS_GITHUB_CLIENT_ID=
PRESS_GITHUB_SECRET_FILE=/run/secrets/github.secret

# The writing: the store (a git repository), what press renders for nginx,
# and the deployed site, for its posts' stylesheet. With Docker, the
# directory above the site is mounted, since every deploy puts a new site
# in its place.
PRESS_CONTENT=/content
PRESS_PUBLIC=/public
PRESS_DIST=/deploy/site

# On a host of its own, without Docker (deploy/systemd/pien-press.service):
#
#   PRESS_LISTEN=127.0.0.1:8096
#   PRESS_DATA=/srv/pien/press/data
#   PRESS_SESSION_KEY_FILE=/etc/pien/session.key
#   PRESS_GITHUB_SECRET_FILE=/etc/pien/github.secret
#   PRESS_CONTENT=/srv/pien/press/content
#   PRESS_PUBLIC=/srv/pien/press/public
#   PRESS_DIST=/srv/pien/site
