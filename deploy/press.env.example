# press's environment on the server (see press/src/config.ts for each).
# The two secrets are files, readable by press's user (1000) only, mounted
# into the container; nothing secret goes in here.

PRESS_SITE=https://arc.moe
PRESS_OWNER=i_noc_cat
PRESS_LISTEN=0.0.0.0:8096
PRESS_DATA=/data
PRESS_SESSION_KEY_FILE=/run/secrets/session.key
PRESS_GITHUB_CLIENT_ID=Ov23liBpCGxRzZdYDhZE
PRESS_GITHUB_SECRET_FILE=/run/secrets/github.secret
# The writing: the store (a git repository), what press renders for nginx,
# and the deployed site, for its posts' stylesheet: the directory above it is
# mounted, since every deploy puts a new site in its place.
PRESS_CONTENT=/content
PRESS_PUBLIC=/public
PRESS_DIST=/deploy/site
