# In front of the site's nginx (deploy/nginx.conf): HTTPS, its certificates
# fetched and renewed by Caddy itself, and everything, the WebSockets of
# `net on` included, passed through as it is (docs/deploy.md). example.com
# stands for the site's own name.

example.com {
	# nginx, on the same host (in Docker too: every container is in the
	# host's own network).
	reverse_proxy 127.0.0.1:8080
}

# Behind a CDN that fetches the site over HTTPS but checks no certificate,
# as this site's is (docs/deploy.md), Caddy signs one with its own CA instead,
# and hands it to a CDN that names no server too: in place of the block
# above,
#
#   {
#   	default_sni example.com
#   	skip_install_trust
#   }
#
#   example.com {
#   	tls internal
#   	reverse_proxy 127.0.0.1:8080
#   }

# Other names of the site, sent on to the one above. Leave this out for a name
# without a DNS record: Caddy would keep asking for a certificate it cannot get.
www.example.com {
	redir https://example.com{uri} permanent
}
