#!/bin/sh
# One-time system setup, before any session starts.

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts /dev/shm
mount -t devpts -o gid=5,mode=620 devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=755 tmpfs /run
ln -sf /proc/self/fd /dev/fd

hostname -F /etc/hostname

# What is written waits in the guest's memory a while before it reaches the
# 9p filesystem; out there is the page, and a folder the visitor shared
# (src/share/). Two seconds, not Linux's thirty, so a file still being
# written reaches the visitor's folder all the same.
echo 200 > /proc/sys/vm/dirty_expire_centisecs
echo 100 > /proc/sys/vm/dirty_writeback_centisecs

# On its first start fish has Python build completions out of man pages, of
# which the image has none: the directory it would fill tells it not to.
install -d -o guest -g guest /home/guest/.cache /home/guest/.cache/fish /home/guest/.cache/fish/generated_completions

# The workbench's toolchain disk, when the machine has one (docs/workbench.md):
# a read-only squashfs whose every top-level directory is laid over the one it
# was installed into, with whatever is written there kept in memory.
if [ -b /dev/sda ]; then
	mkdir -p /run/toolchain
	mount -t squashfs -o ro /dev/sda /run/toolchain
	for lower in /run/toolchain/*/; do
		dir=$(basename "$lower")
		mkdir -p "/run/overlay/$dir/upper" "/run/overlay/$dir/work"
		mount -t overlay -o "lowerdir=$lower:/$dir,upperdir=/run/overlay/$dir/upper,workdir=/run/overlay/$dir/work" overlay "/$dir"
	done
fi

# The console's ports by the names the page gives them, where udev would put
# them: virtio-1 to virtio-3, whatever number the kernel gave the device.
mkdir -p /dev/virtio-ports
for port in /sys/class/virtio-ports/*; do
	ln -sf "../${port##*/}" "/dev/virtio-ports/$(cat "$port/name")"
done

# A serial port lent from the visitor's computer (src/serial/, hostd): the
# third UART. The page reads the speed off the divisor its driver sets, so the
# clock it divides is high, 24 MHz over 16: 1500000, 2000000 and 3000000
# baud come out exact, and the page rounds the near misses (115200 and the
# like, a fraction of a percent off) to the standard speeds they stand for.
setserial /dev/ttyS2 baud_base 24000000
chown guest /dev/ttyS2
mkdir -p /run/serial
echo off > /run/serial/state
chmod 666 /run/serial/state

# A Bluetooth LE device's serial service (src/ble/, hostd): the fourth UART.
# Its speed means nothing: the bytes go as fast as Bluetooth carries them.
# The kernel probes COM4 with the loopback test it spares COM1 to COM3, and
# v86's UART loops bytes back but not the modem lines, so the kernel leaves
# the port unclaimed: it is told what the port is.
setserial /dev/ttyS3 uart 16550A
chown guest /dev/ttyS3
mkdir -p /run/ble
echo off > /run/ble/state
chmod 666 /run/ble/state

# Files the visitor drops on the page, or picks for `drop` (see hostd).
mkdir -p /run/drop
echo none > /run/drop/state
chmod 666 /run/drop/state

# The visitor's USB devices, over USB/IP (see hostd): what each port of the
# console has lent, and how the latest ask for a device went, in a file the
# guest marks "waiting" in; hostd writes the rest.
mkdir -p /run/usb
for port in 1 2 3; do
	echo off > "/run/usb/$port"
done
echo off > /run/usb/state
chmod 666 /run/usb/state

# Folders the visitor shares (see hostd): what each is, and how the latest
# ask for one went, in a file the guest marks "waiting" in.
mkdir -p /run/share
echo off > /run/share/state
chmod 666 /run/share/state

# The guest's questions to the page (__ask.fish): hostd keeps the secret
# they carry here, and writes the answers; only the guest may read them.
install -d -m 700 -o guest -g guest /run/ask

# The network: loopback now, eth0 once a visitor types `net on` (see hostd).
# The state file is the guest's to mark "waiting" in; hostd writes the rest.
ip link set lo up
mkdir -p /run/net
echo off > /run/net/state
chmod 666 /run/net/state
echo '0 2147483647' > /proc/sys/net/ipv4/ping_group_range # ping without root, either family
# On eth0 are the guest and the relay's gateway alone: no address can be
# another's, so IPv6 takes its addresses at once, without the second of
# duplicate detection, and asks the gateway for its advertisement at once.
echo 0 > /proc/sys/net/ipv6/conf/eth0/accept_dad
