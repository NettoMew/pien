#!/bin/sh
# Control line on ttyS1. The page sends one message per line:
#
#   attach <epoch> [zone]
#                    a browser is here: its clock and time zone; start the session
#   clock <epoch>    the browser's clock again, now and then: follow it
#   detach           (image build only) rewind to "waiting for a browser"
#   net up <way> <address/prefix> <gateway> <dns> <mtu>
#                    a way out is up (src/net/): put eth0 on it
#   net down <why>   it went down, or was turned off: take eth0 off again
#   usb key <private> <public> <name>
#                    this browser's adb key, in base64: PKCS#8, and Android's
#                    own form of its public half; adb signs with it
#   usb up <tool> <serial> <name>
#                    a phone is attached for adb or fastboot (src/usb/):
#                    bridge it to where the tool is pointed
#   usb down <tool> <why>
#                    it went away, or was let go: take the bridge down
#   serial up <device> <name>
#                    a serial port from the visitor's computer is attached
#                    (src/serial/): /dev/<device> leads to it, ttyUSB0 for a
#                    wire, rfcomm0 for Bluetooth
#   serial down <why>
#                    it went away, or was let go
#   drop <n>         files from the visitor's computer wait in /.drop/<n>
#                    (src/drop.ts): move them into ~/drop
#   drop none        … or the visitor chose none
#   content <n>      the site's writing, newer than the guest's, waits in
#                    /.content/<n> (src/content.ts): put it in place
#   ask <secret>     what the guest's questions to the page carry (src/ask.ts,
#                    __ask.fish): kept where only the guest's commands read it
#   said <id> <line> a line of the page's answer to question <id>
#   done <id> <status>
#                    … and its end: the question's status
#
# Window sizes need no message: the virtio console reports them itself.

# The browser's time zone, if it is a name tzdata knows.
zone() {
	case $1 in
	"" | *[!A-Za-z0-9_+/-]* | *..*) return ;;
	esac
	[ -f "/usr/share/zoneinfo/$1" ] || return
	ln -sf "/usr/share/zoneinfo/$1" /etc/localtime
	echo "$1" > /etc/timezone
}

# adb and fastboot reach the phone as they would one on the network: adb at
# 127.0.0.1:6555, fastboot at 127.0.0.1:6554 (their usual ports a thousand
# up, clear of the range adb probes for emulators). From there the bytes go
# through a port of the console to the page, and on to the phone.
bridge() {
	case $1 in
	adb) set -- adb 6555 /dev/virtio-ports/virtio-1 ;;
	fastboot) set -- fastboot 6554 /dev/virtio-ports/virtio-2 ;;
	*) return 1 ;;
	esac
	[ -f "/run/usb/$1.pid" ] && return
	# A session of its own, so the connections it forks go down with it; big
	# blocks, for fewer trips through the emulated kernel.
	setsid socat -b 65536 "TCP-LISTEN:$2,bind=127.0.0.1,reuseaddr,fork" "OPEN:$3" 2> /dev/null &
	echo $! > "/run/usb/$1.pid"
}

unbridge() {
	[ -f "/run/usb/$1.pid" ] || return
	kill -- "-$(cat "/run/usb/$1.pid")" 2> /dev/null
	rm -f "/run/usb/$1.pid"
}

# The key adb signs with, in the files adb reads it from; the phone shows
# the name in its list of computers it allows.
adbkey() {
	dir=/home/guest/.android
	mkdir -p "$dir"
	{
		echo '-----BEGIN PRIVATE KEY-----'
		echo "$1" | fold -w 64
		echo '-----END PRIVATE KEY-----'
	} > "$dir/adbkey"
	echo "$2 $3" > "$dir/adbkey.pub"
	chmod 600 "$dir/adbkey"
	chown -R guest:guest "$dir"
}

# Dropped files arrive in a directory the kernel has never seen, so nothing
# it remembers of the filesystem hides them; moving them is a rename, and
# the files stay where they are: on the visitor's computer, read as needed.
drop() {
	case $1 in
	none)
		echo none > /run/drop/state
		return
		;;
	"" | *[!0-9]*) return ;;
	esac
	mkdir -p /home/guest/drop
	ls -A "/.drop/$1" > /run/drop/names
	find "/.drop/$1" -mindepth 1 -maxdepth 1 -exec mv -f {} /home/guest/drop/ \;
	rmdir "/.drop/$1"
	chown guest:guest /home/guest/drop
	echo "$1" > /run/drop/state
}

# The site's writing, newer than the guest's: home/ holds the files new or
# changed, as they go in the guest's home; gone lists those the site no
# longer has; posts, if there, is the list `blog` shows. Each is a rename,
# and the bytes come from the site as they are read, as with dropped files.
content() {
	case $1 in "" | *[!0-9]*) return ;; esac
	src=/.content/$1
	while IFS= read -r path; do
		case $path in
		blog/* | moments/* | media/* | about.md) rm -f "/home/guest/$path" ;;
		esac
	done < "$src/gone"
	(cd "$src/home" && find . -type f) | while IFS= read -r path; do
		path=${path#./}
		mkdir -p "$(dirname "/home/guest/$path")"
		mv -f "$src/home/$path" "/home/guest/$path"
	done
	[ -f "$src/posts" ] && mv -f "$src/posts" /usr/share/home/posts
	for path in blog moments media about.md; do
		[ -e "/home/guest/$path" ] && chown -R guest:guest "/home/guest/$path"
	done
	rm -rf "$src"
}

stty -echo
echo ready

while read -r cmd arg; do
	case $cmd in
	attach)
		set -- $arg
		date -s "@$1" > /dev/null
		zone "$2"
		touch /run/attached
		;;
	clock)
		now=$(date +%s)
		drift=$((arg - now))
		[ "${drift#-}" -gt 1 ] && date -s "@$arg" > /dev/null
		;;
	detach)
		rm -f /run/attached
		echo detached
		;;
	net)
		set -- $arg
		case $1 in
		up)
			ip link set eth0 mtu "$6" up
			ip addr flush dev eth0
			ip addr add "$3" dev eth0
			ip route add "$4" dev eth0 2> /dev/null # on-link already, unless /32
			ip route add default via "$4"
			echo "nameserver $5" > /etc/resolv.conf
			echo "up $2 ${3%/*}" > /run/net/state
			;;
		down)
			ip addr flush dev eth0
			ip link set eth0 down
			shift
			echo "down $*" > /run/net/state
			;;
		esac
		;;
	usb)
		set -- $arg
		case $1 in
		key) adbkey "$2" "$3" "$4" ;;
		up)
			tool=$2
			bridge "$tool"
			shift 2
			# adb's wrapper connects its server to the bridge; a phone back from
			# a reboot is found again by the server itself, which keeps trying.
			echo "up $*" > "/run/usb/$tool"
			;;
		down)
			tool=$2
			unbridge "$tool"
			shift 2
			echo "down $*" > "/run/usb/$tool"
			;;
		esac
		;;
	serial)
		set -- $arg
		case $1 in
		up)
			device=$2
			shift 2
			case $device in ttyUSB0 | rfcomm0) ;; *) continue ;; esac
			rm -f /dev/ttyUSB0 /dev/rfcomm0
			ln -sf ttyS2 "/dev/$device"
			echo "up /dev/$device $*" > /run/serial/state
			;;
		down)
			shift
			rm -f /dev/ttyUSB0 /dev/rfcomm0
			echo "down $*" > /run/serial/state
			;;
		esac
		;;
	drop) drop "$arg" ;;
	content) content "$arg" ;;
	ask)
		(umask 077 && echo "$arg" > /run/ask/secret)
		chown guest:guest /run/ask/secret
		;;
	said)
		id=${arg%% *}
		case $id in "" | *[!0-9]*) continue ;; esac
		case $arg in *" "*) line=${arg#* } ;; *) line= ;; esac
		printf '%s\n' "$line" >> "/run/ask/$id"
		;;
	done)
		set -- $arg
		case $1 in "" | *[!0-9]*) continue ;; esac
		# Whole or not at all: the guest takes the answer once this appears.
		echo "${2:-1}" > "/run/ask/$1.part" && mv "/run/ask/$1.part" "/run/ask/$1.done"
		;;
	esac
done
