#!/bin/sh
# Control line on ttyS1. The page sends one message per line:
#
#   attach <epoch> [zone]
#                    a browser is here: its clock and time zone; start the session
#   clock <epoch>    the browser's clock again, now and then: follow it
#   detach           (image build only) rewind to "waiting for a browser"
#   net up <way> <address/prefix> <gateway> <dns> <mtu>
#                    a way out is up (src/net/): put eth0 on it
#   net down <why>   it went down, or was turned off: take eth0 off again
#   usb key <private> <public> <name>
#                    this browser's adb key, in base64: PKCS#8, and Android's
#                    own form of its public half; adb signs with it
#   usb attach <port> <busid> <name>
#                    a USB device of the visitor's, offered over USB/IP
#                    through that port of the console (src/usb/): attach it
#   usb up <port>    the guest has configured it: give it to the visitor
#   usb detach <port> <why>
#                    it went away, or was let go: unplug it
#   usb down <why>   no device was lent, as asked
#   serial up <device> <name>
#                    a serial port from the visitor's computer is attached
#                    (src/serial/): /dev/<device> leads to it, ttyUSB0 for a
#                    wire, rfcomm0 for Bluetooth
#   serial down <why>
#                    it went away, or was let go
#   ble up <name>    a Bluetooth LE serial device of the visitor's is attached
#                    (src/ble/): /dev/ttyBLE0 leads to it
#   ble down <why>   it went away, or was let go
#   share up <n> <rw|ro>
#                    a folder of the visitor's is listed in /.share/<n>
#                    (src/share/): put it in place, at /mnt/<its name>
#   share down <n> <why>
#                    … and let go of: take it away
#   share none <why> no folder was shared, as asked
#   drop <n>         files from the visitor's computer wait in /.drop/<n>
#                    (src/drop.ts): move them into ~/drop
#   drop none        … or the visitor chose none
#   content <n>      the site's writing, newer than the guest's, waits in
#                    /.content/<n> (src/content.ts): put it in place
#   ask <secret>     what the guest's questions to the page carry (src/ask.ts,
#                    __ask.fish): kept where only the guest's commands read it
#   said <id> <line> a line of the page's answer to question <id>
#   done <id> <status>
#                    … and its end: the question's status
#
# Window sizes need no message: the virtio console reports them itself.

# The browser's time zone, if it is a name tzdata knows.
zone() {
	case $1 in
	"" | *[!A-Za-z0-9_+/-]* | *..*) return ;;
	esac
	[ -f "/usr/share/zoneinfo/$1" ] || return
	ln -sf "/usr/share/zoneinfo/$1" /etc/localtime
	echo "$1" > /etc/timezone
}

# The visitor's USB devices reach the guest's vhci-hcd over USB/IP: `usbip
# attach` connects to a usbipd over TCP and hands the connection to the
# kernel. The usbipd here is the page, at the far end of a port of the
# console, and socat joins the two, one connection to a port, at 127.0.0.1
# 3241 to 3243. Unplugging is the connection closing.
attach() { # <port> <busid> <name>
	case $1 in 1 | 2 | 3) ;; *) return ;; esac
	case $2 in "" | *[!0-9-]*) return ;; esac
	detach "$1"
	echo "attaching $2 $3" > "/run/usb/$1"
	tcp=$((3240 + $1))
	# A session of its own, so it goes down whole; big blocks, for fewer
	# trips through the emulated kernel.
	setsid socat -b 65536 "TCP-LISTEN:$tcp,bind=127.0.0.1,reuseaddr,nodelay" "OPEN:/dev/virtio-ports/virtio-$1" 2> /dev/null &
	echo $! > "/run/usb/$1.pid"
	# usbip has one try at it: socat must be listening first.
	listening=$(printf ':%04X 00000000:0000 0A' "$tcp")
	for i in $(seq 50); do
		grep -q "$listening" /proc/net/tcp && break
		sleep 0.05
	done
	why=$(usbip --tcp-port "$tcp" attach -r 127.0.0.1 -b "$2" 2>&1 > /dev/null) && return
	detach "$1"
	why=$(echo "$why" | grep error: | tail -n1)
	echo "down error ${why:-usbip could not attach it}" > "/run/usb/$1"
	echo "down error ${why:-usbip could not attach it}" > /run/usb/state
}

# Unplugging: socat's end of the connection closes, and the kernel lets the
# device go, as from a cable pulled.
detach() { # <port>
	[ -f "/run/usb/$1.pid" ] || return
	kill -- "-$(cat "/run/usb/$1.pid")" 2> /dev/null
	rm -f "/run/usb/$1.pid"
}

# The guest has configured the device on <port>: its node is the visitor's
# (devtmpfs makes USB nodes root's alone), and the ask for it is answered.
lent() { # <port>
	case $1 in 1 | 2 | 3) ;; *) return ;; esac
	line=$(cat "/run/usb/$1")
	case $line in attaching\ * | up\ *) ;; *) return ;; esac
	chown guest /dev/bus/usb/*/* 2> /dev/null
	echo "up ${line#* }" > "/run/usb/$1"
	echo "up $1 ${line#* }" > /run/usb/state
}

# The key adb signs with, in the files adb reads it from; the phone shows
# the name in its list of computers it allows.
adbkey() {
	dir=/home/guest/.android
	mkdir -p "$dir"
	{
		echo '-----BEGIN PRIVATE KEY-----'
		echo "$1" | fold -w 64
		echo '-----END PRIVATE KEY-----'
	} > "$dir/adbkey"
	echo "$2 $3" > "$dir/adbkey.pub"
	chmod 600 "$dir/adbkey"
	chown -R guest:guest "$dir"
}

# Dropped files arrive in a directory the kernel has never seen, so nothing
# it remembers of the filesystem hides them; moving them is a rename, and
# the files stay where they are: on the visitor's computer, read as needed.
drop() {
	case $1 in
	none)
		echo none > /run/drop/state
		return
		;;
	"" | *[!0-9]*) return ;;
	esac
	mkdir -p /home/guest/drop
	ls -A "/.drop/$1" > /run/drop/names
	find "/.drop/$1" -mindepth 1 -maxdepth 1 -exec mv -f {} /home/guest/drop/ \;
	rmdir "/.drop/$1"
	chown guest:guest /home/guest/drop
	echo "$1" > /run/drop/state
}

# A folder the visitor shared, listed in a directory the guest has never
# seen, as dropped files are, and moved to /mnt under its own name, or with
# a number after it if one by that name is there.
share() { # <n> <rw|ro>
	case $1 in "" | *[!0-9]*) return ;; esac
	for listed in "/.share/$1"/*; do break; done
	[ -d "$listed" ] || return
	name=${listed##*/} path=/mnt/${listed##*/}
	i=1
	while [ -e "$path" ]; do
		i=$((i + 1))
		path=/mnt/$name-$i
	done
	mv "$listed" "$path"
	rmdir "/.share/$1"
	echo "up $2 $path" > "/run/share/$1"
	echo "up $2 $path" > /run/share/state
}

# The site's writing, newer than the guest's: home/ holds the files new or
# changed, as they go in the guest's home; gone lists those the site no
# longer has; posts, if there, is the list `blog` shows. Each is a rename,
# and the bytes come from the site as they are read, as with dropped files.
content() {
	case $1 in "" | *[!0-9]*) return ;; esac
	src=/.content/$1
	while IFS= read -r path; do
		case $path in
		blog/* | moments/* | media/* | about.md) rm -f "/home/guest/$path" ;;
		esac
	done < "$src/gone"
	(cd "$src/home" && find . -type f) | while IFS= read -r path; do
		path=${path#./}
		mkdir -p "$(dirname "/home/guest/$path")"
		mv -f "$src/home/$path" "/home/guest/$path"
	done
	[ -f "$src/posts" ] && mv -f "$src/posts" /usr/share/home/posts
	for path in blog moments media about.md; do
		[ -e "/home/guest/$path" ] && chown -R guest:guest "/home/guest/$path"
	done
	rm -rf "$src"
}

stty -echo
echo ready

while read -r cmd arg; do
	case $cmd in
	attach)
		set -- $arg
		date -s "@$1" > /dev/null
		zone "$2"
		touch /run/attached
		;;
	clock)
		now=$(date +%s)
		drift=$((arg - now))
		[ "${drift#-}" -gt 1 ] && date -s "@$arg" > /dev/null
		;;
	detach)
		rm -f /run/attached
		echo detached
		;;
	net)
		set -- $arg
		case $1 in
		up)
			# Down first: every way out starts afresh, IPv6 too. Coming up,
			# the kernel asks the gateway for its advertisement, and makes
			# an address from it if the way out gives one.
			ip link set eth0 down
			ip addr flush dev eth0
			ip link set eth0 mtu "$6" up
			ip addr add "$3" dev eth0
			ip route add "$4" dev eth0 2> /dev/null # on-link already, unless /32
			ip route add default via "$4"
			echo "nameserver $5" > /etc/resolv.conf
			echo "up $2 ${3%/*}" > /run/net/state
			;;
		down)
			ip addr flush dev eth0
			ip link set eth0 down
			shift
			echo "down $*" > /run/net/state
			;;
		esac
		;;
	usb)
		# A device names itself: the page keeps its name to printable ASCII,
		# which may still hold a wildcard, so no word of it is expanded.
		set -f
		set -- $arg
		set +f
		case $1 in
		key) adbkey "$2" "$3" "$4" ;;
		attach)
			port=$2 busid=$3
			shift 3
			attach "$port" "$busid" "$*"
			;;
		up) lent "$2" ;;
		detach)
			case $2 in 1 | 2 | 3) ;; *) continue ;; esac
			detach "$2"
			port=$2
			shift 2
			echo "down $*" > "/run/usb/$port"
			;;
		down)
			shift
			echo "down $*" > /run/usb/state
			;;
		esac
		;;
	serial)
		set -- $arg
		case $1 in
		up)
			device=$2
			shift 2
			case $device in ttyUSB0 | rfcomm0) ;; *) continue ;; esac
			rm -f /dev/ttyUSB0 /dev/rfcomm0
			ln -sf ttyS2 "/dev/$device"
			echo "up /dev/$device $*" > /run/serial/state
			;;
		down)
			shift
			rm -f /dev/ttyUSB0 /dev/rfcomm0
			echo "down $*" > /run/serial/state
			;;
		esac
		;;
	ble)
		# The name is the device's own, which anyone near can make anything:
		# taken whole, never split or expanded.
		case $arg in
		up\ *)
			ln -sf ttyS3 /dev/ttyBLE0
			printf 'up /dev/ttyBLE0 %s\n' "${arg#up }" > /run/ble/state
			;;
		down\ *)
			rm -f /dev/ttyBLE0
			printf 'down %s\n' "${arg#down }" > /run/ble/state
			;;
		esac
		;;
	share)
		set -- $arg
		case $1 in
		up) share "$2" "$3" ;;
		down)
			case $2 in "" | *[!0-9]*) continue ;; esac
			# The page has let go of the folder: what is removed here is the
			# guest's listing of it, never a file of the visitor's.
			read -r up mode path < "/run/share/$2"
			case $path in /mnt/?*) rm -rf "$path" ;; esac
			rm -f "/run/share/$2"
			echo "down $3" > /run/share/state
			;;
		none) echo "down $2" > /run/share/state ;;
		esac
		;;
	drop) drop "$arg" ;;
	content) content "$arg" ;;
	ask)
		(umask 077 && echo "$arg" > /run/ask/secret)
		chown guest:guest /run/ask/secret
		;;
	said)
		id=${arg%% *}
		case $id in "" | *[!0-9]*) continue ;; esac
		case $arg in *" "*) line=${arg#* } ;; *) line= ;; esac
		printf '%s\n' "$line" >> "/run/ask/$id"
		;;
	done)
		set -- $arg
		case $1 in "" | *[!0-9]*) continue ;; esac
		# Whole or not at all: the guest takes the answer once this appears.
		echo "${2:-1}" > "/run/ask/$1.part" && mv "/run/ask/$1.part" "/run/ask/$1.done"
		;;
	esac
done
