# The guest kernel: just enough for v86 — four serial lines, the virtio
# console, a root filesystem served over 9p, and the visitor's USB devices
# over USB/IP. Everything is built in, so the kernel mounts its root itself:
# no modules, no initramfs.
#
# Applied on top of `allnoconfig` (see build.sh); anything not named here is off.

CONFIG_LOCALVERSION="-arc"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y

# The machine v86 emulates
CONFIG_M686=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_PCI=y
CONFIG_PCI_GODIRECT=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# What userland (busybox, musl, fish) leans on
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_POSIX_TIMERS=y
# musl on i386 still makes the 32-bit time syscalls (pselect6 and friends)
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Terminals: ttyS0 for the kernel log, ttyS1 for the control line, ttyS2 for
# a serial port lent from the visitor's computer (it shares COM1's IRQ, as
# COM3 does), ttyS3 for a Bluetooth LE serial device of the visitor's (it
# shares COM2's, as COM4 does), hvc0 for the visitor
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_CONSOLE=y

# The root filesystem: 9p over virtio, which wants a (device-less) network stack
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y

# eth0, for `net on` (docs/relay.md): IPv4 and IPv6 over a virtio network
# card. The relay hands the guest its IPv6 address by DHCPv6, and udhcpc6,
# as every DHCP client must, asks before it has an address to ask from:
# through a packet socket
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# The workbench's toolchain disk (docs/workbench.md): a read-only squashfs on
# v86's IDE controller, an Intel PIIX3, its top-level directories laid over
# the guest's with overlayfs, whose upper layer in tmpfs needs xattrs
CONFIG_TMPFS_XATTR=y
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
# The visitor's USB devices (src/usb/usbip.ts): the USB core, and USB/IP's
# virtual host controller, which takes its devices over a socket from the
# page, a usbipd of sorts. No drivers of classes: the tools reach the
# devices themselves, through usbfs
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y
CONFIG_USBIP_VHCI_HC_PORTS=8
CONFIG_USBIP_VHCI_NR_HCS=1
